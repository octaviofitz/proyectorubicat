<!DOCTYPE html>
<html lang="es">
  <%- include('./partials/head') %> 

  <body>
    <%- include('partials/navBar.ejs') %>
    <%- include('partials/scriptNavbar') %>


    <main class="newProductos">

      <section class="newProductos__filtros">

        <h1 class="newProductos__titulo reveal-letters">
          COMPARÁ LOS PRODUCTOS RUBICAT
        </h1>

        <p class="newProductos__texto">
          Seleccioná los filtros que quieras para encontrar, elegir y comparar los productos de Rubicat. Una vez seleccionados, podés desplazarte hacia los costados para explorar todas las opciones.</p>

        <!-- FILTROS -->
        <div
          class="newProductos__filter-list"
          id="npFilters"
          role="tablist"
          aria-label="Filtrar productos"
        ></div>


        <!-- CARDS -->
        <div class="newProductos__carousel">

          <div class="newProductos__track-wrap">
            <div
              class="newProductos__track"
              id="npTrack"
            ></div>
          </div>

        </div>


        <!-- INDICADORES -->
        <div
          class="newProductos__dots"
          id="npDots"
        ></div>

      </section>

    </main>
   
      <%- include('partials/scriptTitulos') %>
      <%- include('partials/ScriptComparaProductos') %>
    <%- include('partials/newFooter') %>
    <%- include('./partials/scripts') %>

  </body>
</html>