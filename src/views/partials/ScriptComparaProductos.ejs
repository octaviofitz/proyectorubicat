          sub: "26.7 KG",
          type: "BENTONITA",
          tags: ["bidones", "bolsas", "bentonita"],
          img: "/images/NewIndex/Productos/PremiumMixto.webp",
          description: "Una combinación pensada para quienes buscan mayor disponibilidad de producto.",
          absorcion: 3,
