    /* ============================================================
       GENERAR FILTROS
       ============================================================ */
  
    function renderFilters() {
  
      filtersContainer.innerHTML = "";
  
      FILTERS.forEach(function (filter) {
  
        const button =
          document.createElement("button");
  
        button.type = "button";
  
        button.className =
          "np-pill" +
          (filter.id === activeFilter
            ? " is-active"
            : "");
  
        button.textContent =
          filter.label;
  
        button.dataset.filter =
          filter.id;
  
        button.style.setProperty(
          "--np-pill-color",
          filter.color
        );
  
        button.setAttribute(
          "role",
          "tab"
        );
  
        button.setAttribute(
          "aria-selected",
          filter.id === activeFilter
            ? "true"
            : "false"
        );
  
  
        button.addEventListener(
          "click",
          function () {
  
            activeFilter =
              filter.id;
  
            renderFilters();
            renderProducts();
  
          }
        );
  
  
        filtersContainer.appendChild(button);
  
      });
  
    }
  
  
    /* ============================================================
       FILTRAR PRODUCTOS
       ============================================================ */
  
    function getProducts() {
  
      if (activeFilter === "todos") {
        return PRODUCTS;
      }
  
      return PRODUCTS.filter(
        function (product) {
  
          return product.tags.includes(
            activeFilter
          );
  
        }
      );
  
    }

