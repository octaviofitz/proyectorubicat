        absorcion: 4,
        accion: 4,
        olores: 4,
        cumulos: 2,
        rendimiento: 4,
        color: "azul"
      }
  
    ];
  
  
    /* ============================================================
       FILTROS
       ============================================================ */
  
    const FILTERS = [
  
      {
        id: "todos",
        label: "Todos",
        color: "#222"
      },
  
      {
        id: "favoritos",
        label: "Favoritos",
        color: "#00AFC0"
      },
  
      {
        id: "bolsas",
        label: "Bolsas",
        color: "#F28B30"
      },
  
      {
        id: "bidones",
        label: "Bidones",
        color: "#98C21E"
      },
  
      {
        id: "bentonita",
        label: "Bentonita",
        color: "#DC5572"
      },
  
      {
        id: "silica",
        label: "Sílica",
        color: "#8B85CA"
      },
  
      {
        id: "diatomea",
        label: "Diatomea",
        color: "#222"
      }
  
    ];
  
  
    /* ============================================================
       ELEMENTOS DEL HTML
       ============================================================ */
  
    const filtersContainer =
      document.getElementById("npFilters");
  
    const track =
      document.getElementById("npTrack");
  
    const dotsContainer =
      document.getElementById("npDots");
  
  
    if (!filtersContainer || !track) {
      return;
    }
  
  
    /* ============================================================
       ESTADO
       ============================================================ */
  
    let activeFilter = "todos";
  
  
    /* ============================================================
       GENERAR FILTROS
       ============================================================ */
  
    function renderFilters() {
  
      filtersContainer.innerHTML = "";
  
      FILTERS.forEach(function (filter) {
  
        const button =
          document.createElement("button");
  
        button.type = "button";
  
        button.className =
          "np-pill" +
          (filter.id === activeFilter
            ? " is-active"
            : "");
  
        button.textContent =
          filter.label;
  
        button.dataset.filter =
          filter.id;
  
        button.style.setProperty(
          "--np-pill-color",
          filter.color
        );
  
        button.setAttribute(
          "role",
          "tab"
        );
  
        button.setAttribute(
          "aria-selected",
          filter.id === activeFilter
            ? "true"
            : "false"
        );
  
  
        button.addEventListener(
          "click",
          function () {
  
            activeFilter =
              filter.id;
  
            renderFilters();
            renderProducts();
  
          }
        );
  
  
        filtersContainer.appendChild(button);
  
      });
  
    }
  
  
    /* ============================================================
       FILTRAR PRODUCTOS
       ============================================================ */
  
    function getProducts() {
  
      if (activeFilter === "todos") {
        return PRODUCTS;
      }
  
      return PRODUCTS.filter(
        function (product) {
  
          return product.tags.includes(
            activeFilter
          );
  
        }
      );
  
    }
  
  
    /* ============================================================
       ICONO GOTAS
       ============================================================ */
  
    function createDrops(number) {
  
      let html = "";
  
      for (
        let i = 0;
        i < number;
        i++
      ) {
  
        html += `
          <span class="np-stat-item">
        <img
          src="/images/NewIndex/Iconos/gota.webp"
          alt=""
          aria-hidden="true"
        >
      </span>
        `;
  
      }
  
      return html;
  
    }
  
  
    /* ============================================================
       ICONO RELOJ
       ============================================================ */
  
    function createClock(number) {
  
      let html = "";
  
      for (
        let i = 0;
        i < number;
        i++
      ) {
  
        html += `
          <span class="np-stat-item">
        <img
          src="/images/NewIndex/Iconos/Reloj.webp"
          alt=""
          aria-hidden="true"
        >
      </span>
        `;
  
      }
  
      return html;
  
    }
  
  
    /* ============================================================
       ICONO OLORES
       ============================================================ */
  
    function createOdor(number) {
  
      let html = "";
  
      for (
        let i = 0;
        i < number;
        i++
      ) {
  
        html += `
           <span class="np-stat-item">
        <img
          src="/images/NewIndex/Iconos/Olores.webp"
          alt=""
          aria-hidden="true"
        >
      </span>
          </span>
        `;
  
      }
  
      return html;
  
    }
  
  
    /* ============================================================
       ICONO PALITAS
       ============================================================ */
  
    function createClumps(number) {
  
      let html = "";
  
      for (
        let i = 0;
        i < number;
        i++
      ) {
  
        html += `
         <span class="np-stat-item">
        <img
          src="/images/NewIndex/Iconos/Pala.webp"
          alt=""
          aria-hidden="true"
              style="margin-top: 0.75rem;"

        >
      </span>
        `;
  
      }
  
      return html;
  
    }
  
  
    /* ============================================================
       RENDIMIENTO - GRÁFICO DE BARRAS
       ============================================================ */
  
    function createBars(number) {
  
      let html = "";
  
      for (
        let i = 0;
        i < 5;
        i++
      ) {
  
        html += `
          <span
            class="np-bar ${i < number ? "is-active" : ""}"
          ></span>
        `;
  
      }
  
      return html;
  
    }
  
  
    /* ============================================================
       COLOR DE CARD
       ============================================================ */
  
    function getCardColor(product) {
  
      return `np-bg-${product.color}`;
  
    }
  
  
    /* ============================================================
       CREAR CARD
       ============================================================ */
  
    function createCard(product) {
  
      const card =
        document.createElement("article");
  
      card.className =
        "np-card";
  
  
      const colorClass =
        getCardColor(product);
  
  
      card.innerHTML = `
  
        <div class="np-card-inner ${colorClass}">
  
          <img
            class="np-product-img"
            src="${product.img}"
            alt="Rubicat ${product.name} ${product.sub}"
            loading="lazy"
            decoding="async"
          >
  
  
          <div class="np-info">
  
            <h2 class="np-info-title">
              Descripción
            </h2>
  
            <p class="np-info-text">
              ${product.description}
            </p>
  
          </div>
  
  
          <div class="np-info">
  
            <h2 class="np-info-title">
              Capacidad de absorción
            </h2>
  
            <div class="np-stat">
              ${createDrops(product.absorcion)}
            </div>
  
          </div>
  
  
          <div class="np-info">
  
            <h2 class="np-info-title">
              Tiempo de acción
            </h2>
  
            <div class="np-stat">
              ${createClock(product.accion)}
            </div>
  
          </div>
  
  
          <div class="np-info">
  
            <h2 class="np-info-title">
              Retención de olores
            </h2>
  
            <div class="np-stat">
              ${createOdor(product.olores)}
            </div>
  
          </div>
  
  
          <div class="np-info">
  
            <h2 class="np-info-title">
              Resistencia de los cúmulos
            </h2>
  
            <div class="np-stat np-clumps">
              ${createClumps(product.cumulos)}
            </div>
  
          </div>
  
  
          <div class="np-info">
  
            <h2 class="np-info-title">
              Rendimiento
            </h2>
  
            <div class="np-stat np-performance">
              ${createBars(product.rendimiento)}
            </div>
  
          </div>
  
        </div>
  
      `;
  
  
      return card;
  
    }
  
  
    /* ============================================================
       GENERAR DOTS
       ============================================================ */
  
    function renderDots(number) {
  
      if (!dotsContainer) {
        return;
      }
  
      dotsContainer.innerHTML = "";
  
  
      for (
        let i = 0;
        i < number;
        i++
      ) {
  
        const dot =
          document.createElement("button");
  
        dot.type = "button";
  
        dot.className =
          "np-dot" +
          (i === 0
            ? " is-active"
            : "");
  
        dot.setAttribute(
          "aria-label",
          "Ver producto " + (i + 1)
        );
  
  
        dot.addEventListener(
          "click",
          function () {
  
            const cards =
              track.querySelectorAll(
                ".np-card"
              );
  
            if (!cards[i]) {
              return;
            }
  
  
            cards[i].scrollIntoView({
              behavior: "smooth",
              block: "nearest",
              inline: "center"
            });
  
          }
        );
  
  
        dotsContainer.appendChild(dot);
  
      }
  
    }
  
  
    /* ============================================================
       RENDERIZAR PRODUCTOS
       ============================================================ */
  
    function renderProducts() {
  
      const products =
        getProducts();
  
  
      track.innerHTML = "";
  
      track.scrollLeft = 0;
  
  
      if (!products.length) {
  
        track.innerHTML = `
          <div class="np-empty">
            No encontramos productos
            para este filtro.
          </div>
        `;
  
        if (dotsContainer) {
          dotsContainer.innerHTML = "";
        }
  
        return;
  
      }
  
  
      products.forEach(
        function (product) {
  
          track.appendChild(
            createCard(product)
          );
  
        }
      );
  
  
      renderDots(
        products.length
      );
  
    }
  
  
    /* ============================================================
       DETECTAR CARD ACTIVA
       (escucha en el elemento que realmente scrollea: #npTrack)
       ============================================================ */
  
    let scrollTimeout;
  
  
    track.addEventListener(
      "scroll",
      function () {
  
        clearTimeout(
          scrollTimeout
        );
  
  
        scrollTimeout =
          setTimeout(
            function () {
  
              const cards =
                track.querySelectorAll(
                  ".np-card"
                );
  
  
              if (
                !cards.length ||
                !dotsContainer
              ) {
                return;
              }
  
  
              const trackRect =
                track.getBoundingClientRect();
  
              const trackCenter =
                trackRect.left +
                trackRect.width / 2;
  
  
              let closest =
                0;
  
              let closestDistance =
                Infinity;
  
  
              cards.forEach(
                function (card, index) {
  
                  const rect =
                    card.getBoundingClientRect();
  
                  const cardCenter =
                    rect.left +
                    rect.width / 2;
  
  
                  const distance =
                    Math.abs(
                      cardCenter -
                      trackCenter
                    );
  
  
                  if (
                    distance <
                    closestDistance
                  ) {
  
                    closestDistance =
                      distance;
  
                    closest =
                      index;
  
                  }
  
                }
              );
  
  
              Array.from(
                dotsContainer.children
              ).forEach(
                function (dot, index) {
  
                  dot.classList.toggle(
                    "is-active",
                    index === closest
                  );
  
                }
              );
  
            },
            50
          );
  
      }
    );
  
  
    /* ============================================================
       AUTO SCROLL CONTINUO
       Se mueve solo todo el tiempo. Se pausa mientras el
       usuario interactúa (touch / drag / wheel) y retoma
       un rato después de que suelta.
       ============================================================ */
  
    let autoScrollRAF = null;
    let isUserInteracting = false;
    let resumeTimeout = null;
  
    const AUTO_SCROLL_SPEED = 0.4; // px por frame — subí este número para que vaya más rápido
    const RESUME_DELAY = 2500; // ms de espera tras soltar, antes de retomar
  
  
    function autoScrollStep() {
  
      if (!isUserInteracting && track) {
  
        const maxScroll =
          track.scrollWidth - track.clientWidth;
  
  
        if (maxScroll > 0) {
  
          if (track.scrollLeft >= maxScroll - 1) {
  
            track.scrollLeft = 0;
  
          } else {
  
            track.scrollLeft += AUTO_SCROLL_SPEED;
  
          }
  
        }
  
      }
  
  
      autoScrollRAF =
        requestAnimationFrame(autoScrollStep);
  
    }
  
  
    function startAutoScroll() {
  
      if (!autoScrollRAF) {
  
        autoScrollRAF =
          requestAnimationFrame(autoScrollStep);
  
      }
  
    }
  
  
    function pauseAutoScrollTemporarily() {
  
      isUserInteracting = true;
  
      clearTimeout(resumeTimeout);
  
      resumeTimeout =
        setTimeout(
          function () {
  
            isUserInteracting = false;
  
          },
          RESUME_DELAY
        );
  
    }
  
  
    track.addEventListener(
      "touchstart",
      pauseAutoScrollTemporarily,
      { passive: true }
    );
  
    track.addEventListener(
      "pointerdown",
      pauseAutoScrollTemporarily
    );
  
    track.addEventListener(
      "wheel",
      pauseAutoScrollTemporarily,
      { passive: true }
    );
  
  
    /* ============================================================
       INICIO
       ============================================================ */
  
    renderFilters();
  
    renderProducts();
  
    startAutoScroll();
  
  });
  </script>
