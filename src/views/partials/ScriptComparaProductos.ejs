    function renderDots(number) {
  
      if (!dotsContainer) {
        return;
      }
  
      dotsContainer.innerHTML = "";
  
  
      for (
        let i = 0;
        i < number;
        i++
      ) {
  
        const dot =
          document.createElement("button");
  
        dot.type = "button";
  
        dot.className =
          "np-dot" +
          (i === 0
            ? " is-active"
            : "");
  
        dot.setAttribute(
          "aria-label",
          "Ver producto " + (i + 1)
        );
  
  
        dot.addEventListener(
          "click",
          function () {
  
            const cards =
              track.querySelectorAll(
                ".np-card"
              );
  
            if (!cards[i]) {
              return;
            }
  
  
            cards[i].scrollIntoView({
              behavior: "smooth",
              block: "nearest",
              inline: "center"
            });
  
          }
        );
  
  
        dotsContainer.appendChild(dot);
  
      }
  
    }
  
  
    /* ============================================================
