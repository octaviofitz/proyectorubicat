          absorcion: 4,
          accion: 4,
          olores: 4,
          cumulos: 2,
          rendimiento: 4,
          color: "azul"
        }
    
      ];
    
    
      /* ============================================================
         FILTROS
         ============================================================ */
    
      const FILTERS = [
    
        {
          id: "todos",
          label: "Todos",
          color: "#222"
        },
    
        {
          id: "favoritos",
          label: "Favoritos",
          color: "#00AFC0"
        },
    
        {
          id: "bolsas",
          label: "Bolsas",
          color: "#F28B30"
        },
    
        {
          id: "bidones",
          label: "Bidones",
          color: "#98C21E"
        },
    
        {
          id: "bentonita",
          label: "Bentonita",
          color: "#DC5572"
        },
    
        {
          id: "silica",
          label: "Sílica",
          color: "#8B85CA"
        },
    
        {
          id: "diatomea",
          label: "Diatomea",
          color: "#222"
        }
    
      ];
    
    
      /* ============================================================
         ELEMENTOS DEL HTML
         ============================================================ */
    
      const filtersContainer =
        document.getElementById("npFilters");
    
      const track =
        document.getElementById("npTrack");
    
      const dotsContainer =
        document.getElementById("npDots");
    
    
      if (!filtersContainer || !track) {
        return;
      }
    
    
      /* ============================================================
         ESTADO
         ============================================================ */
    
      let activeFilter = "todos";
    
    
      /* ============================================================
         GENERAR FILTROS
         ============================================================ */
    
      function renderFilters() {
    
        filtersContainer.innerHTML = "";
    
        FILTERS.forEach(function (filter) {
    
          const button =
            document.createElement("button");
    
          button.type = "button";
    
          button.className =
            "np-pill" +
            (filter.id === activeFilter
              ? " is-active"
              : "");
    
          button.textContent =
            filter.label;
    
          button.dataset.filter =
            filter.id;
    
          button.style.setProperty(
            "--np-pill-color",
            filter.color
          );
    
          button.setAttribute(
            "role",
            "tab"
          );
    
          button.setAttribute(
            "aria-selected",
            filter.id === activeFilter
              ? "true"
              : "false"
          );
    
    
          button.addEventListener(
            "click",
            function () {
    
              activeFilter =
                filter.id;
    
              renderFilters();
              renderProducts();
    
            }
          );
    
    
          filtersContainer.appendChild(button);
    
        });
    
      }
    
    
      /* ============================================================
         FILTRAR PRODUCTOS
         ============================================================ */
    
      function getProducts() {
    
        if (activeFilter === "todos") {
          return PRODUCTS;
        }
    
        return PRODUCTS.filter(
          function (product) {
    
            return product.tags.includes(
              activeFilter
            );
    
          }
        );
    
      }
    
    
      /* ============================================================
         ICONO GOTAS
         ============================================================ */
    
      function createDrops(number) {
    
        let html = "";
    
        for (
          let i = 0;
          i < number;
          i++
        ) {
    
          html += `
            <span class="np-stat-item">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M12 2C12 2 5.5 10.1 5.5 15.2C5.5 18.9 8.4 21.5 12 21.5C15.6 21.5 18.5 18.9 18.5 15.2C18.5 10.1 12 2 12 2Z"
                  stroke="currentColor"
                  stroke-width="1.8"
                />
              </svg>
            </span>
          `;
    
        }
    
        return html;
    
      }
    
    
      /* ============================================================
         ICONO RELOJ
         ============================================================ */
    
      function createClock(number) {
    
        let html = "";
    
        for (
          let i = 0;
          i < number;
          i++
        ) {
    
          html += `
            <span class="np-stat-item">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
    
                <circle
                  cx="12"
                  cy="13"
                  r="8.5"
                  stroke="currentColor"
                  stroke-width="1.8"
                />
    
                <path
                  d="M12 8.5V13L15 15"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
    
                <path
                  d="M9 3H15"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
    
              </svg>
            </span>
          `;
    
        }
    
        return html;
    
      }
    
    
      /* ============================================================
         ICONO OLORES
         ============================================================ */
    
      function createOdor(number) {
    
        let html = "";
    
        for (
          let i = 0;
          i < number;
          i++
        ) {
    
          html += `
            <span class="np-stat-item">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
    
                <path
                  d="M5 8C7 8 7 11 9 11C11 11 11 8 13 8"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
    
                <path
                  d="M5 13C7 13 7 16 9 16C11 16 11 13 13 13"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
    
                <path
                  d="M11 8C13 8 13 11 15 11C17 11 17 8 19 8"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                />
    
              </svg>
            </span>
          `;
    
        }
    
        return html;
    
      }
    
    
      /* ============================================================
         ICONO PALITAS
         ============================================================ */
    
      function createClumps(number) {
    
        let html = "";
    
        for (
          let i = 0;
          i < number;
          i++
        ) {
    
          html += `
            <span class="np-stat-item">
              <img
                src="/images/iconos/palita.webp"
                alt=""
                aria-hidden="true"
              >
            </span>
          `;
    
        }
    
        return html;
    
      }
    
    
      /* ============================================================
         RENDIMIENTO - GRÁFICO DE BARRAS
         ============================================================ */
    
      function createBars(number) {
    
        let html = "";
    
        for (
          let i = 0;
          i < 5;
          i++
        ) {
    
          html += `
            <span
              class="np-bar ${i < number ? "is-active" : ""}"
            ></span>
          `;
    
        }
    
        return html;
    
      }
    
    
      /* ============================================================
         COLOR DE CARD
         ============================================================ */
    
      function getCardColor(product) {
    
        return `np-bg-${product.color}`;
    
      }
    
    
      /* ============================================================
         CREAR CARD
         ============================================================ */
    
      function createCard(product) {
    
        const card =
          document.createElement("article");
    
        card.className =
          "np-card";
    
    
        const colorClass =
          getCardColor(product);
    
    
        card.innerHTML = `
    
          <div class="np-card-inner ${colorClass}">
    
            <img
              class="np-product-img"
              src="${product.img}"
              alt="Rubicat ${product.name} ${product.sub}"
              loading="lazy"
              decoding="async"
            >
    
    
            <div class="np-info">
    
              <h2 class="np-info-title">
                Descripción
              </h2>
    
              <p class="np-info-text">
                ${product.description}
              </p>
    
            </div>
    
    
            <div class="np-info">
    
              <h2 class="np-info-title">
                Capacidad de absorción
              </h2>
    
              <div class="np-stat">
                ${createDrops(product.absorcion)}
              </div>
    
            </div>
    
    
            <div class="np-info">
    
              <h2 class="np-info-title">
                Tiempo de acción
              </h2>
    
              <div class="np-stat">
                ${createClock(product.accion)}
              </div>
    
            </div>
    
    
            <div class="np-info">
    
              <h2 class="np-info-title">
                Retención de olores
              </h2>
    
              <div class="np-stat">
                ${createOdor(product.olores)}
              </div>
    
            </div>
    
    
            <div class="np-info">
    
              <h2 class="np-info-title">
                Resistencia de los cúmulos
              </h2>
    
              <div class="np-stat np-clumps">
                ${createClumps(product.cumulos)}
              </div>
    
            </div>
    
    
            <div class="np-info">
    
              <h2 class="np-info-title">
                Rendimiento
              </h2>
    
              <div class="np-stat np-performance">
                ${createBars(product.rendimiento)}
              </div>
    
            </div>
    
          </div>
    
        `;
    
    
        return card;
    
      }
    
    
      /* ============================================================
         GENERAR DOTS
         ============================================================ */
    
      function renderDots(number) {
    
        if (!dotsContainer) {
          return;
        }
    
        dotsContainer.innerHTML = "";
    
    
        for (
          let i = 0;
          i < number;
          i++
        ) {
    
          const dot =
            document.createElement("button");
    
          dot.type = "button";
    
          dot.className =
            "np-dot" +
            (i === 0
              ? " is-active"
              : "");
    
          dot.setAttribute(
            "aria-label",
            "Ver producto " + (i + 1)
          );
    
    
          dot.addEventListener(
            "click",
            function () {
    
              const cards =
                track.querySelectorAll(
                  ".np-card"
                );
    
              if (!cards[i]) {
                return;
              }
    
    
              cards[i].scrollIntoView({
                behavior: "smooth",
                block: "nearest",
                inline: "start"
              });
    
            }
          );
    
    
          dotsContainer.appendChild(dot);
    
        }
    
      }
    
    
      /* ============================================================
         RENDERIZAR PRODUCTOS
         ============================================================ */
    
      function renderProducts() {
    
        const products =
          getProducts();
    
    
        track.innerHTML = "";
    
    
        if (!products.length) {
    
          track.innerHTML = `
            <div class="np-empty">
              No encontramos productos
              para este filtro.
            </div>
          `;
    
          if (dotsContainer) {
            dotsContainer.innerHTML = "";
          }
    
          return;
    
        }
    
    
        products.forEach(
          function (product) {
    
            track.appendChild(
              createCard(product)
            );
    
          }
        );
    
    
        renderDots(
          products.length
        );
    
      }
    
    
      /* ============================================================
         DETECTAR CARD ACTIVA
         ============================================================ */
    
      let scrollTimeout;
    
    
      track.addEventListener(
        "scroll",
        function () {
    
          clearTimeout(
            scrollTimeout
          );
    
    
          scrollTimeout =
            setTimeout(
              function () {
    
                const cards =
                  track.querySelectorAll(
                    ".np-card"
                  );
    
    
                if (
                  !cards.length ||
                  !dotsContainer
                ) {
                  return;
                }
    
    
                const trackRect =
                  track.getBoundingClientRect();
    
    
                let closest =
                  0;
    
                let closestDistance =
                  Infinity;
    
    
                cards.forEach(
                  function (card, index) {
    
                    const rect =
                      card.getBoundingClientRect();
    
    
                    const distance =
                      Math.abs(
                        rect.left -
                        trackRect.left
                      );
    
    
                    if (
                      distance <
                      closestDistance
                    ) {
    
                      closestDistance =
                        distance;
    
                      closest =
                        index;
    
                    }
    
                  }
                );
    
    
                Array.from(
                  dotsContainer.children
                ).forEach(
                  function (dot, index) {
    
                    dot.classList.toggle(
                      "is-active",
                      index === closest
                    );
    
                  }
                );
    
              },
              50
            );
    
        }
      );
    
    
      /* ============================================================
         INICIO
         ============================================================ */
    
      renderFilters();
    
      renderProducts();
    
    });
    </script>