    }

    function pauseAutoScrollTemporarily() {

isUserInteracting = true;

track.classList.remove("np-no-snap"); // reactiva el snap para que la card quede centrada al soltar

clearTimeout(resumeTimeout);

resumeTimeout =
  setTimeout(
    function () {

      isUserInteracting = false;

      track.classList.add("np-no-snap"); // vuelve a apagar el snap para que el auto-scroll no vibre

    },
    RESUME_DELAY
  );

}
  
  
    /* ============================================================
       GENERAR DOTS
       ============================================================ */
  
    function renderDots(number) {
  
      if (!dotsContainer) {
        return;
      }
  
      dotsContainer.innerHTML = "";
  
  
      for (
        let i = 0;
        i < number;
        i++
      ) {
  
        const dot =
          document.createElement("button");
  
        dot.type = "button";
  
        dot.className =
          "np-dot" +
          (i === 0
            ? " is-active"
            : "");
  
        dot.setAttribute(
          "aria-label",
          "Ver producto " + (i + 1)
        );
  
  
        dot.addEventListener(
          "click",
          function () {
  
            const cards =
              track.querySelectorAll(
                ".np-card"
              );
  
            if (!cards[i]) {
              return;
            }
  
  
            cards[i].scrollIntoView({
              behavior: "smooth",
              block: "nearest",
              inline: "center"
            });
  
          }
        );
  
  
        dotsContainer.appendChild(dot);
  
      }
  
    }
  
  
    /* ============================================================
       RENDERIZAR PRODUCTOS
       ============================================================ */
  
       function renderProducts() {

const products =
  getProducts();


track.innerHTML = "";

track.scrollLeft = 0;


if (!products.length) {

  track.innerHTML = `
    <div class="np-empty">
      No encontramos productos
      para este filtro.
    </div>
  `;

  if (dotsContainer) {
    dotsContainer.innerHTML = "";
  }

  return;

}


products.forEach(
  function (product) {

    track.appendChild(
      createCard(product)
    );

  }
);


equalizeCardHeights();


renderDots(
  products.length
);

}

    /* ============================================================
   IGUALAR ALTURA DE CARDS
   ============================================================ */

function equalizeCardHeights() {

const cards =
  track.querySelectorAll(".np-card-inner");

if (!cards.length) {
  return;
}

cards.forEach(function (card) {
  card.style.height = "auto";
});

let maxHeight = 0;

cards.forEach(function (card) {

  const height =
    card.getBoundingClientRect().height;

  if (height > maxHeight) {
    maxHeight = height;
  }

});

cards.forEach(function (card) {
  card.style.height = maxHeight + "px";
});

}
  
  
    /* ============================================================
       DETECTAR CARD ACTIVA
       (escucha en el elemento que realmente scrollea: #npTrack)
       ============================================================ */
  
    let scrollTimeout;
  
  
    track.addEventListener(
      "scroll",
      function () {
  
        clearTimeout(
          scrollTimeout
        );
  
  
        scrollTimeout =
          setTimeout(
            function () {
  
              const cards =
                track.querySelectorAll(
                  ".np-card"
                );
  
  
              if (
                !cards.length ||
                !dotsContainer
              ) {
                return;
              }
  
  
              const trackRect =
                track.getBoundingClientRect();
  
              const trackCenter =
                trackRect.left +
                trackRect.width / 2;
  
  
              let closest =
                0;
  
              let closestDistance =
                Infinity;
  
  
              cards.forEach(
                function (card, index) {
  
                  const rect =
                    card.getBoundingClientRect();
  
                  const cardCenter =
                    rect.left +
                    rect.width / 2;
  
  
                  const distance =
                    Math.abs(
                      cardCenter -
                      trackCenter
                    );
  
  
                  if (
                    distance <
                    closestDistance
                  ) {
  
                    closestDistance =
                      distance;
  
                    closest =
                      index;
  
                  }
  
                }
              );
  
  
              Array.from(
                dotsContainer.children
              ).forEach(
                function (dot, index) {
  
                  dot.classList.toggle(
                    "is-active",
                    index === closest
                  );
  
                }
              );
  
            },
            50
          );
  
      }
    );
  
  
    /* ============================================================
       AUTO SCROLL CONTINUO
       Se mueve solo todo el tiempo. Se pausa mientras el
       usuario interactúa (touch / drag / wheel) y retoma
       un rato después de que suelta.
       ============================================================ */
  
    let autoScrollRAF = null;
    let isUserInteracting = false;
    let resumeTimeout = null;
  
    const AUTO_SCROLL_SPEED = 0.4; // px por frame — subí este número para que vaya más rápido
    const RESUME_DELAY = 2500; // ms de espera tras soltar, antes de retomar
  
  
    function autoScrollStep() {
  
      if (!isUserInteracting && track) {
  
        const maxScroll =
          track.scrollWidth - track.clientWidth;
  
  
        if (maxScroll > 0) {
  
          if (track.scrollLeft >= maxScroll - 1) {
  
            track.scrollLeft = 0;
  
          } else {
  
            track.scrollLeft += AUTO_SCROLL_SPEED;
  
          }
  
        }
  
      }
  
  
      autoScrollRAF =
        requestAnimationFrame(autoScrollStep);
  
    }
  
  
    function startAutoScroll() {
  
      if (!autoScrollRAF) {
  
        autoScrollRAF =
          requestAnimationFrame(autoScrollStep);
  
      }
  
    }
  
  
    function pauseAutoScrollTemporarily() {
  
      isUserInteracting = true;
  
      clearTimeout(resumeTimeout);
  
      resumeTimeout =
        setTimeout(
          function () {
  
            isUserInteracting = false;
  
          },
          RESUME_DELAY
        );
  
    }
  
  
    track.addEventListener(
      "touchstart",
      pauseAutoScrollTemporarily,
      { passive: true }
    );
  
    track.addEventListener(
      "pointerdown",
      pauseAutoScrollTemporarily
    );
  
    track.addEventListener(
      "wheel",
      pauseAutoScrollTemporarily,
      { passive: true }
    );
  
  
    /* ============================================================
       INICIO
       ============================================================ */

       preloadImages();
  
    renderFilters();
  
    renderProducts();

    track.classList.add("np-no-snap");

  
    startAutoScroll();
  
  });
  </script>
