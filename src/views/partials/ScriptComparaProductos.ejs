       function renderProducts() {

const products =
  getProducts();


track.innerHTML = "";

track.scrollLeft = 0;


if (!products.length) {

  track.innerHTML = `
    <div class="np-empty">
      No encontramos productos
      para este filtro.
    </div>
  `;

  if (dotsContainer) {
    dotsContainer.innerHTML = "";
  }

  return;

}


products.forEach(
  function (product) {

    track.appendChild(
      createCard(product)
    );

  }
);


equalizeCardHeights();


renderDots(
  products.length
);

}

    /* ============================================================
   IGUALAR ALTURA DE CARDS
   ============================================================ */

function equalizeCardHeights() {

const cards =
  track.querySelectorAll(".np-card-inner");

if (!cards.length) {
  return;
}

cards.forEach(function (card) {
  card.style.height = "auto";
});

let maxHeight = 0;

cards.forEach(function (card) {

  const height =
    card.getBoundingClientRect().height;

  if (height > maxHeight) {
    maxHeight = height;
  }

});

cards.forEach(function (card) {
  card.style.height = maxHeight + "px";
});

}
  
  
    /* ============================================================
       DETECTAR CARD ACTIVA
       (escucha en el elemento que realmente scrollea: #npTrack)
       ============================================================ */
  
    let scrollTimeout;
  
  
    track.addEventListener(
      "scroll",
      function () {
  
        clearTimeout(
          scrollTimeout
        );
  
  
        scrollTimeout =
          setTimeout(
            function () {
  
              const cards =
                track.querySelectorAll(
                  ".np-card"
                );
  
  
              if (
                !cards.length ||
                !dotsContainer
              ) {
                return;
              }
  
  
              const trackRect =
                track.getBoundingClientRect();
  
              const trackCenter =
                trackRect.left +
                trackRect.width / 2;
  
  
              let closest =
                0;
  
              let closestDistance =
                Infinity;
  
  
              cards.forEach(
                function (card, index) {
  
                  const rect =
                    card.getBoundingClientRect();
  
                  const cardCenter =
                    rect.left +
                    rect.width / 2;
  
  
                  const distance =
                    Math.abs(
                      cardCenter -
                      trackCenter
                    );
  
  
                  if (
                    distance <
                    closestDistance
                  ) {
  
                    closestDistance =
                      distance;
  
                    closest =
                      index;
  
                  }
  
                }
              );
  
  
              Array.from(
                dotsContainer.children
              ).forEach(
                function (dot, index) {
  
                  dot.classList.toggle(
                    "is-active",
                    index === closest
                  );
  
                }
              );
  
            },
            50
          );
  
      }
    );
  
  
    /* ============================================================
       AUTO SCROLL CONTINUO
       Se mueve solo todo el tiempo. Se pausa mientras el
       usuario interactúa (touch / drag / wheel) y retoma
       un rato después de que suelta (incluye el scroll por
       inercia/momentum, ya que también escuchamos touchend
       / pointerup). Al llegar al final, vuelve al inicio con
       un scroll suave (scrollTo smooth) en vez de un salto
       instantáneo, que era lo que generaba el temblor.
       ============================================================ */
  
    let autoScrollRAF = null;
    let isUserInteracting = false;
    let isResetting = false;
    let resumeTimeout = null;
  
    const AUTO_SCROLL_SPEED = 0.4; // px por frame — subí este número para que vaya más rápido
    const RESUME_DELAY = 3000; // ms de espera tras soltar, antes de retomar
    const RESET_DURATION = 700; // ms aprox. que tarda el scrollTo smooth en volver al inicio
  
  
    function autoScrollStep() {
  
      if (!isUserInteracting && !isResetting && track) {
  
        const maxScroll =
          track.scrollWidth - track.clientWidth;
  
  
        if (maxScroll > 2) {
  
          if (track.scrollLeft >= maxScroll - 2) {
  
            // en vez de saltar de golpe a 0 (lo que generaba el
            // temblor en la última card), hacemos un scroll suave
            isResetting = true;
  
            track.scrollTo({
              left: 0,
              behavior: "smooth"
            });
  
            setTimeout(
              function () {
                isResetting = false;
              },
              RESET_DURATION
            );
  
          } else {
  
            track.scrollLeft += AUTO_SCROLL_SPEED;
  
          }
  
        }
  
      }
  
  
      autoScrollRAF =
        requestAnimationFrame(autoScrollStep);
  
    }
  
  
    function startAutoScroll() {
  
      if (!autoScrollRAF) {
  
        autoScrollRAF =
          requestAnimationFrame(autoScrollStep);
  
      }
  
    }
  
  
    function pauseAutoScrollTemporarily() {
  
      isUserInteracting = true;
  
      clearTimeout(resumeTimeout);
  
      resumeTimeout =
        setTimeout(
          function () {
  
            isUserInteracting = false;
  
          },
          RESUME_DELAY
        );
  
    }
  
  
    // Pausa al empezar a interactuar...
    track.addEventListener(
      "touchstart",
      pauseAutoScrollTemporarily,
      { passive: true }
    );
  
    track.addEventListener(
      "pointerdown",
      pauseAutoScrollTemporarily
    );
  
    track.addEventListener(
      "wheel",
      pauseAutoScrollTemporarily,
      { passive: true }
    );
  
    // ...y también al soltar, para cubrir el scroll por inercia
    // (momentum) que sigue moviéndose después de que el dedo ya
    // no toca la pantalla. Esto evita que el auto-scroll retome
    // justo cuando el swipe todavía se está "asentando".
    track.addEventListener(
      "touchend",
      pauseAutoScrollTemporarily,
      { passive: true }
    );
  
    track.addEventListener(
      "pointerup",
      pauseAutoScrollTemporarily
    );
  
  
    /* ============================================================
       INICIO
       ============================================================ */

       preloadImages();
  
    renderFilters();
  
    renderProducts();

    track.classList.add("np-no-snap");

  
    startAutoScroll();
  
  });


  </script>


