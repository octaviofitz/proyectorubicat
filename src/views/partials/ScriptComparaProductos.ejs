       ============================================================ */
  
       function createClumps(value) {

if (typeof value !== "number") {

  return `<p class="np-clumps-text">${value}</p>`;

}

let html = "";

for (let i = 0; i < value; i++) {

  html += `
    <span class="np-stat-item">
      <img
        src="/images/NewIndex/Iconos/Pala.webp"
        alt=""
        aria-hidden="true"
        style="margin-top: 0.75rem;"
      >
    </span>
  `;

}

return html;

}
  
  
