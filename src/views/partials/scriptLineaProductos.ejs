<script>
  /*
    rubicat-carousel.js
    Requiere el markup de rubicat-carousel.html en el DOM
    (los ids #rcFilters y #rcTrack).
  
    Mecánica: marquee continuo (tipo "trencito"), sin transición dura entre
    slides. Al cambiar de filtro, se reconstruye la cinta solo con los
    productos que matchean y arranca de nuevo desde el principio.
  */
  document.addEventListener("DOMContentLoaded", function(){
  
    /* ---------------- data ---------------- */
    var FILTERS = [
      { id:"todos",       label:"Todos",        color:"var(--ink)"           },
      { id:"bidones",     label:"Bidones",      color:"var(--c-bidones)"     },
      { id:"bolsas",      label:"Bolsas",       color:"var(--c-bolsas)"      },
      { id:"10kg",        label:"+10kg",        color:"var(--c-10kg)"        },
      { id:"5kg",         label:"5kg",          color:"var(--c-5kg)"         },
      { id:"bentonita",   label:"Bentonita",    color:"var(--c-bentonita)"   },
      { id:"silica",      label:"Sílica",       color:"var(--c-silica)"      },
      { id:"microesferas",label:"Microesferas", color:"var(--c-microesferas)"}
    ];
  
    // El ORDEN de este array = el orden en el que aparecen en la cinta.
    // El primero que escribís es el primero que se ve (más a la izquierda).
    var PRODUCTS = [
      { name:"Silica Aglutinante",   sub:"3.8 KG",  type:"SILICA",       tagline:"BOLSA AGLUTINANTE", theme:"orange", cardBg:"cream", tags:["bolsas","5kg","silica"], img:"/images/NewIndex/Productos/Silica.webp"},
      { name:"Silica Aglutinante",   sub:"3.8 KG",  type:"SILICA",       tagline:"BOLSA AGLUTINANTE", theme:"red",    cardBg:"cream", tags:["bolsas","5kg","silica"], img:"/images/NewIndex/Productos/SilicaAglutinante.webp"},
      { name:"Classic bidón",    sub:"5.3 KG",  type:"BENTONITA",    tagline:"BOLSA AGLUTINANTE", theme:"pink",   cardBg:"dark",  tags:["bidones","5kg","bentonita"], img:"/images/NewIndex/Productos/ClassicBidon.webp" },
      { name:"Classic bolson",    sub:"15 KG",  type:"BENTONITA",    tagline:"BOLSA AGLUTINANTE", theme:"pink",   cardBg:"dark",  tags:["bolsas","10kg","bentonita"], img:"/images/NewIndex/Productos/ClassicBolsa.webp" },
      { name:"Classic bolsón y bidón",    sub:"20.3 KG",  type:"BENTONITA",    tagline:"BOLSA AGLUTINANTE", theme:"pink",   cardBg:"dark",  tags:["bolsas", "bidones", "10kg","bentonita"], img:"/images/NewIndex/Productos/ClassicMixto.webp" },
      { name:"Classic Lavanda",    sub:"5.3 KG",  type:"BENTONITA",    tagline:"BIDÓN AGLUTINANTE", theme:"pink",   cardBg:"dark",  tags:["bidones", "5kg","bentonita"], img:"/images/NewIndex/Productos/Lavanda.webp" },
      { name:"Original",    sub:"5 KG",  type:"BENTONITA",    tagline:"BIDÓN AGLUTINANTE", theme:"pink",   cardBg:"dark",  tags:["bidones", "5kg","bentonita"], img:"/images/NewIndex/Productos/Original.webp" },
      { name:"Detox",    sub:"5 KG",  type:"BENTONITA",    tagline:"BIDÓN AGLUTINANTE", theme:"pink",   cardBg:"dark",  tags:["bidones", "5kg","bentonita"], img:"/images/NewIndex/Productos/Detox.webp" },
      { name:"Premium Bolsa",    sub:"10 KG",  type:"BENTONITA",    tagline:"BOLSA AGLUTINANTE", theme:"pink",   cardBg:"dark",  tags:["bolsas", "10kg","bentonita"], img:"/images/NewIndex/Productos/PremiumBolsa.webp" },
      { name:"Premium Bidón",    sub:"5.7 KG",  type:"BENTONITA",    tagline:"BIDÓN AGLUTINANTE", theme:"pink",   cardBg:"dark",  tags:["bidones", "5kg","bentonita"], img:"/images/NewIndex/Productos/PremiumBidon5KG.webp" },
      { name:"Premium Bidón 11KG",    sub:"11 KG",  type:"BENTONITA",    tagline:"BIDÓN AGLUTINANTE", theme:"pink",   cardBg:"dark",  tags:["bidones", "10kg","bentonita"], img:"/images/NewIndex/Productos/PremiumBidon11KG.webp" },
      { name:"Premium Bidones y Bolsa",    sub:"26.7 KG",  type:"BENTONITA",    tagline:"BIDÓN AGLUTINANTE", theme:"pink",   cardBg:"dark",  tags:["bidones", "bolsas", "10kg","bentonita"], img:"/images/NewIndex/Productos/PremiumMixto.webp" },
      { name:"Sensitive",    sub:"5 KG",  type:"BENTONITA",    tagline:"BOLSA AGLUTINANTE", theme:"pink",   cardBg:"dark",  tags:["bolsas", "5kg","bentonita"], img:"/images/NewIndex/Productos/Sensitive.webp" },
      { name:"Sensitive Microesferas",    sub:"5 KG",  type:"BENTONITA",    tagline:"BOLSA AGLUTINANTE", theme:"pink",   cardBg:"dark",  tags:[ "bolsas", "microesferas", "5kg","bentonita"], img:"/images/NewIndex/Productos/SensitiveMicroesferas.webp" },
    ];
  
    /* ---------------- state ---------------- */
    var activeFilter = FILTERS[0].id;
    var SPEED = 22; // píxeles por segundo. Subilo para más rápido, bajalo para más lento.
  
    var filtersEl = document.getElementById("rcFilters");
    var trackEl   = document.getElementById("rcTrack");
  
    if(!filtersEl || !trackEl){
      console.warn("rubicat-carousel: no se encontró el markup (#rcFilters/#rcTrack) en el DOM.");
      return;
    }
  
    /* ---------------- render filters (once) ---------------- */
    FILTERS.forEach(function(f){
      var btn = document.createElement("button");
      btn.className = "rc-pill" + (f.id === activeFilter ? " is-active" : "");
      btn.textContent = f.label;
      btn.style.setProperty("--pill-color", f.color);
      btn.setAttribute("role","tab");
      btn.setAttribute("aria-selected", f.id === activeFilter ? "true" : "false");
      btn.dataset.filter = f.id;
      btn.addEventListener("click", function(){ selectFilter(f.id); });
      filtersEl.appendChild(btn);
    });
  
    function selectFilter(id){
      if(id === activeFilter) return;
      activeFilter = id;
      Array.prototype.forEach.call(filtersEl.children, function(el){
        var on = el.dataset.filter === id;
        el.classList.toggle("is-active", on);
        el.setAttribute("aria-selected", on ? "true" : "false");
      });
      renderTrack();
    }
  
    /* ---------------- build cards ---------------- */
    function getFiltered(){
      if(activeFilter === "todos"){
        // Todos los productos, pero mostrando primero los que son "bolsas".
        return PRODUCTS.slice().sort(function(a, b){
          var aBolsa = a.tags.indexOf("bolsas") !== -1 ? 0 : 1;
          var bBolsa = b.tags.indexOf("bolsas") !== -1 ? 0 : 1;
          return aBolsa - bBolsa;
        });
      }
      return PRODUCTS.filter(function(p){ return p.tags.indexOf(activeFilter) !== -1; });
    }
  
    function cardHTML(p){
      return (
        '<div class="rc-card">' +
          '<div class="rc-card-inner bg-' + p.cardBg + '">' +
            '<span class="rc-card-badge">' + p.sub + '</span>' +
            '<img class="rc-product-img" src="' + p.img + '" alt="Rubicat ' + p.name + '">' +
          '</div>' +
        '</div>'
      );
    }
  
    /* ---------------- medir ancho de un set de N cards ---------------- */
    function measureSetWidth(count){
      var gap = 14;
      var cards = trackEl.children;
      var width = 0;
      for (var i = 0; i < count; i++){
        width += cards[i].getBoundingClientRect().width + gap;
      }
      return width;
    }
  
    /* ---------------- render + marquee ---------------- */
    function renderTrack(){
      var items = getFiltered();
  
      trackEl.style.animation = "none";
      trackEl.style.transform = "translateX(0)";
      trackEl.innerHTML = "";
  
      if(items.length === 0){
        trackEl.innerHTML = '<div class="rc-empty">No hay productos en esta categoría todavía.</div>';
        return;
      }
  
      // Primero armamos un solo set (sin duplicar) para medir si entra
      // completo en el ancho visible sin necesidad de scrollear.
      trackEl.innerHTML = items.map(cardHTML).join("");
  
      requestAnimationFrame(function(){
        requestAnimationFrame(function(){
          var wrapWidth = trackEl.parentElement.clientWidth;
          var singleWidth = measureSetWidth(items.length);
  
          if(singleWidth <= wrapWidth){
            // Entran todas las cards sin necesidad de loop: quedan fijas,
            // sin animación y sin repetirse.
            trackEl.style.animation = "none";
            trackEl.style.transform = "translateX(0)";
            return;
          }
  
          // No entran todas: armamos el loop duplicado y arrancamos el marquee.
          var loop = items.concat(items);
          trackEl.innerHTML = loop.map(cardHTML).join("");
  
          requestAnimationFrame(function(){
            requestAnimationFrame(function(){ startMarquee(items.length); });
          });
        });
      });
    }
  
    function startMarquee(originalCount){
      var distance = measureSetWidth(originalCount);
  
      trackEl.style.setProperty("--rc-distance", -distance + "px");
      var duration = distance / SPEED;
  
      trackEl.style.animation = "none";
      void trackEl.offsetWidth; // fuerza reflow para poder reiniciar la animación
      trackEl.style.animation = "rc-marquee " + duration + "s linear infinite";
    }
  
    /* ---------------- pausa con hover / touch ---------------- */
    var wrap = document.querySelector(".rc-carousel");
    wrap.addEventListener("mouseenter", function(){ trackEl.style.animationPlayState = "paused"; });
    wrap.addEventListener("mouseleave", function(){ trackEl.style.animationPlayState = "running"; });
    wrap.addEventListener("touchstart", function(){ trackEl.style.animationPlayState = "paused"; }, {passive:true});
    wrap.addEventListener("touchend", function(){ trackEl.style.animationPlayState = "running"; });
  
    /* ---------------- resize: recalcular distancia/velocidad ---------------- */
    var resizeTimer;
    window.addEventListener("resize", function(){
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(renderTrack, 200);
    });
  
    /* ---------------- init ---------------- */
    renderTrack();
  
  });
  </script>
  