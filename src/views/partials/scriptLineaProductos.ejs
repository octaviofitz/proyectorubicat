  /* ---------------- state ---------------- */
  var activeFilter = FILTERS[0].id;
  var SPEED = 22; // píxeles por segundo del auto-scroll.
  
  /* ---------------- color del panel de detalle según producto ---------------- */
  // Un color específico por línea de producto. Se matchea por el nombre
  // (en minúsculas), así no hace falta agregar un campo nuevo en cada
  // objeto de PRODUCTS. OJO con el orden: "silica aglutinante" se chequea
  // antes que "silica" a secas, porque si no, "silica" matchearía primero.
  var PRODUCT_COLOR_MAP = [
    { match: "silica aglutinante", color: "#f3a624" },
    { match: "silica",             color: "#F84A13" },
    { match: "lavanda",            color: "#8B85CA" },
    { match: "premium",            color: "#FF8C1E" },
    { match: "classic",            color: "#00ACBB" },
    { match: "microesferas",       color: "#F0B533" },
    { match: "sensitive",          color: "#dc5572" },
    { match: "original",           color: "#98c21e" },
    { match: "detox",              color: "#cedd00" },
    { match: "diatomea",           color: "#0092BB" }
  ];
  
  function getProductColor(p){
    var name = (p.name || "").toLowerCase();
    for (var i = 0; i < PRODUCT_COLOR_MAP.length; i++){
      if(name.indexOf(PRODUCT_COLOR_MAP[i].match) !== -1){
        return PRODUCT_COLOR_MAP[i].color;
      }
    }
    return "#FF8C1E";
  }
  
  /* ---------------- precarga de imágenes ---------------- */
  // Precarga TODAS las imágenes de todos los productos (de card y de
  // detalle, sin importar el filtro activo) para que, al cambiar de
  // filtro o abrir el panel de detalle, las imágenes ya estén en la
  // caché del navegador y aparezcan al instante, sin esperar la
  // descarga. Se dispara en idle time para no competir con la carga
  // inicial de la página ni con la primera card (que va con
  // fetchpriority="high").
  var preloadedImages = [];
  function preloadAllImages(){
    var seen = {};
    function preload(url){
      if(!url || seen[url]) return;
      seen[url] = true;
      var img = new Image();
      img.src = url;
      preloadedImages.push(img); // referencia para que no lo recolecte el GC
    }
    PRODUCTS.forEach(function(p){
      preload(p.img);
      preload(p.detailImg1);
      preload(p.detailImg2);
    });
  }
  
  if("requestIdleCallback" in window){
    requestIdleCallback(preloadAllImages, { timeout: 2000 });
  } else {
    setTimeout(preloadAllImages, 300);
  }
  
  var filtersEl = document.getElementById("rcFilters");
  var trackEl   = document.getElementById("rcTrack");
  var dotsEl    = document.getElementById("rcDots"); // opcional: si no existe, simplemente no hay dots
  
  if(!filtersEl || !trackEl){
    console.warn("rubicat-carousel: no se encontró el markup (#rcFilters/#rcTrack) en el DOM.");
    return;
  }
  
  /* ---------------- panel de detalle (solo tiene efecto visual en desktop) ---------------- */
  var detailEl  = document.getElementById("rcDetail");
  var elEyebrow = document.getElementById("rcDetailEyebrow");
  var elTitle   = document.getElementById("rcDetailTitle");
  var elSub     = document.getElementById("rcDetailSubtitle");
  var elDesc    = document.getElementById("rcDetailDesc");
  var elImg1    = document.getElementById("rcDetailImg1");
  var elImg2    = document.getElementById("rcDetailImg2");
  
  function escapeAttr(str){
    return String(str == null ? "" : str).replace(/"/g, "&quot;");
  }
  
  function showDetail(data){
    if(!detailEl) return;
    elEyebrow.textContent = data.eyebrow || "";
    elTitle.textContent   = data.title || "";
    elSub.textContent     = data.subtitle || "";
    elDesc.textContent    = data.desc || "";
    elImg1.src = data.img1 || "";
    elImg1.alt = "Rubicat " + (data.title || "");
    elImg2.src = data.img2 || "";
    elImg2.alt = "Rubicat " + (data.title || "");
  
    detailEl.style.setProperty("--detail-color", data.color || "#FF8C1E");
  
    detailEl.classList.add("is-active");
    detailEl.setAttribute("aria-hidden", "false");
  }
  
  function hideDetail(){
    if(!detailEl) return;
    detailEl.classList.remove("is-active");
    detailEl.setAttribute("aria-hidden", "true");
  }
  
  // Muestra el detalle a partir de un objeto de PRODUCTS (no de un <div>
  // del DOM) — se usa para abrir el primer producto por default al cargar
  // y para el caso de "un solo producto en el filtro".
  function showDetailFromProduct(p){
    if(!p) return;
    showDetail({
      eyebrow:  p.detailEyebrow,
      title:    p.name,
      subtitle: p.detailSubtitle,
      desc:     p.description,
      img1:     p.detailImg1 || p.img,
      img2:     p.detailImg2 || p.img,
      color:    getProductColor(p)
    });
  }
  
  // Delegación de eventos sobre el track: como las cards se recrean en
  // cada renderTrack() (cambio de filtro, resize), escuchar en el
  // contenedor padre evita tener que reasignar el listener cada vez.
  trackEl.addEventListener("click", function(e){
    var card = e.target.closest(".rc-card");
    if(!card) return;
    showDetail({
      eyebrow:  card.dataset.eyebrow,
      title:    card.dataset.title,
      subtitle: card.dataset.subtitle,
      desc:     card.dataset.desc,
      img1:     card.dataset.img1,
      img2:     card.dataset.img2,
      color:    card.dataset.color
    });
  });
  
  var prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  
  var position = 0;        // desplazamiento actual en px
  var singleWidth = 0;     // ancho de UN set completo de productos (sin duplicar)
  var itemOffsets = [];    // offset acumulado de cada producto (para dots/flechas)
  var rafId = null;
  var lastTs = null;
  var isPaused = false;    // pausa solo mientras se arrastra en mobile
  var isDragging = false;
  var dragStartX = 0;
  var dragStartPosition = 0;
  var touchStartY = 0;
  
  /* ---------------- render filters (once) ---------------- */
  FILTERS.forEach(function(f){
    var btn = document.createElement("button");
    btn.className = "rc-pill" + (f.id === activeFilter ? " is-active" : "");
    btn.textContent = f.label;
    btn.style.setProperty("--pill-color", f.color);
    btn.setAttribute("role","tab");
    btn.setAttribute("aria-selected", f.id === activeFilter ? "true" : "false");
    btn.dataset.filter = f.id;
    btn.addEventListener("click", function(){ selectFilter(f.id); });
    filtersEl.appendChild(btn);
  });
  
  function selectFilter(id){
    if(id === activeFilter) return;
    activeFilter = id;
    Array.prototype.forEach.call(filtersEl.children, function(el){
      var on = el.dataset.filter === id;
      el.classList.toggle("is-active", on);
      el.setAttribute("aria-selected", on ? "true" : "false");
    });
    renderTrack("filter");
  }
  
  /* ---------------- build cards ---------------- */
  function getFiltered(){
    if(activeFilter === "todos"){
      // Todos los productos, pero mostrando primero los que son "bolsas".
      return PRODUCTS.slice().sort(function(a, b){
        var aBolsa = a.tags.indexOf("bolsas") !== -1 ? 0 : 1;
        var bBolsa = b.tags.indexOf("bolsas") !== -1 ? 0 : 1;
        return aBolsa - bBolsa;
      });
    }
    return PRODUCTS.filter(function(p){ return p.tags.indexOf(activeFilter) !== -1; });
  }
  
  function cardHTML(p, isPriority){
    // isPriority: true solo para la primera card, que es la única
    // garantizada visible apenas carga la página → se pide con prioridad
    // alta y sin lazy-load. El resto carga lazy + decode async para no
    // trabar el hilo principal ni la animación. Como además precargamos
    // todas las imágenes en background (ver preloadAllImages), aunque
    // sean "lazy" ya van a estar en la caché del navegador al momento
    // de insertarse en el DOM.
    var loadingAttrs = isPriority
      ? 'loading="eager" fetchpriority="high" decoding="async"'
      : 'loading="lazy" decoding="async"';
  
    // data-* con la info necesaria para el panel de detalle (desktop).
    // Si detailImg1/detailImg2 no están cargados, usamos p.img como
    // fallback para no dejar el panel con imágenes rotas.
    var dataAttrs =
      'data-eyebrow="'  + escapeAttr(p.detailEyebrow)          + '" ' +
      'data-title="'    + escapeAttr(p.name)                   + '" ' +
      'data-subtitle="' + escapeAttr(p.detailSubtitle)         + '" ' +
      'data-desc="'     + escapeAttr(p.description)            + '" ' +
      'data-img1="'     + escapeAttr(p.detailImg1 || p.img)    + '" ' +
      'data-img2="'     + escapeAttr(p.detailImg2 || p.img)    + '" ' +
      'data-color="'    + escapeAttr(getProductColor(p))       + '"';
  
    return (
      '<div class="rc-card" ' + dataAttrs + '>' +
        '<div class="rc-card-inner bg-' + p.cardBg + '">' +
          // Etiqueta de kilaje sacada temporalmente (ver nota más abajo
          // en el código para reactivarla).
          '<img class="rc-product-img" src="' + p.img + '" alt="Rubicat ' + p.name + '" ' + loadingAttrs + '>' +
        '</div>' +
      '</div>'
    );
  }
  
  /* ---------------- medir offsets de un set de N cards ---------------- */
  function measureOffsets(count){
    var gap = 14;
    var cards = trackEl.children;
    var offsets = [];
    var acc = 0;
    for (var i = 0; i < count; i++){
      offsets.push(acc);
      acc += cards[i].getBoundingClientRect().width + gap;
    }
    return { offsets: offsets, total: acc };
  }
  
  /* ---------------- índice actual (para dots y flechas) ---------------- */
  function getCurrentIndex(){
    var current = 0;
    for (var i = 0; i < itemOffsets.length; i++){
      if(itemOffsets[i] <= position) current = i;
    }
    return current;
  }
  
  /* ---------------- dots ---------------- */
  function buildDots(count){
    if(!dotsEl) return;
    dotsEl.innerHTML = "";
    for (var i = 0; i < count; i++){
      (function(i){
        var dot = document.createElement("button");
        dot.className = "rc-dot" + (i === 0 ? " is-active" : "");
        dot.setAttribute("aria-label", "Ir al producto " + (i + 1));
        dot.addEventListener("click", function(){
          position = itemOffsets[i] || 0;
        });
        dotsEl.appendChild(dot);
      })(i);
    }
  }
  
  function updateActiveDot(){
    if(!dotsEl || !itemOffsets.length) return;
    var current = getCurrentIndex();
    Array.prototype.forEach.call(dotsEl.children, function(d, i){
      d.classList.toggle("is-active", i === current);
    });
  }
  
  /* ---------------- flechas (desktop) ---------------- */
  var prevBtn = document.getElementById("rcPrev");
  var nextBtn = document.getElementById("rcNext");
  
  function setArrowsVisible(visible){
    // "" deja que el CSS decida (las muestra solo en desktop, vía media
    // query); "none" las oculta siempre, sin importar el ancho de pantalla.
    if(prevBtn) prevBtn.style.display = visible ? "" : "none";
    if(nextBtn) nextBtn.style.display = visible ? "" : "none";
  }
  
  if(prevBtn){
    prevBtn.addEventListener("click", function(){
      if(!itemOffsets.length) return;
      var idx = (getCurrentIndex() - 1 + itemOffsets.length) % itemOffsets.length;
      position = itemOffsets[idx];
    });
  }
  if(nextBtn){
    nextBtn.addEventListener("click", function(){
      if(!itemOffsets.length) return;
      var idx = (getCurrentIndex() + 1) % itemOffsets.length;
      position = itemOffsets[idx];
    });
  }
  
  /* ---------------- render + loop ----------------
     reason indica por qué se está re-renderizando el track:
       "init"   -> primera carga de la página
       "filter" -> el usuario cambió de filtro arriba
       "resize" -> cambió el tamaño de la ventana
  
     Comportamiento del panel de detalle según reason:
       - Si el filtro resultante tiene UN SOLO producto, se muestra su
         info automáticamente (sea init, filter o resize).
       - Si tiene más de uno y reason === "filter", se esconde el panel
         (no debe quedar la info de un producto que ya no aplica).
       - Si tiene más de uno y reason === "init", se abre con el primero.
       - Si tiene más de uno y reason === "resize", no se toca el panel.
  */
  function renderTrack(reason){
    reason = reason || "resize";
  
    cancelAnimation();
    trackEl.classList.remove("rc-track--static");
    trackEl.style.transform = "translateX(0)";
    trackEl.innerHTML = "";
    if(dotsEl) dotsEl.innerHTML = "";
    itemOffsets = [];
    position = 0;
  
    var items = getFiltered();
  
    if(items.length === 0){
      trackEl.innerHTML = '<div class="rc-empty">No hay productos en esta categoría todavía.</div>';
      setArrowsVisible(false);
      hideDetail();
      return;
    }
  
    if(items.length === 1){
      // Único producto en el filtro: mostramos su info directamente,
      // no tiene sentido pedirle al usuario que lo clickee.
      showDetailFromProduct(items[0]);
    } else if(reason === "filter"){
      hideDetail();
    }
  
    // Primero armamos un solo set (sin duplicar) para medir si entra
    // completo en el ancho visible sin necesidad de scrollear.
    trackEl.innerHTML = items.map(function(p, i){ return cardHTML(p, i === 0); }).join("");
  
    requestAnimationFrame(function(){
      requestAnimationFrame(function(){
        var wrapWidth = trackEl.parentElement.clientWidth;
        var single = measureOffsets(items.length);
  
        if(single.total <= wrapWidth){
          // Entran todas sin necesidad de loop: quedan fijas y centradas,
          // sin animación, sin dots ni flechas (no hace falta navegar).
          trackEl.classList.add("rc-track--static");
          setArrowsVisible(false);
        } else {
          // No entran todas: duplicamos para el loop y arrancamos el auto-scroll.
          var loop = items.concat(items);
          trackEl.innerHTML = loop.map(function(p, i){ return cardHTML(p, i === 0); }).join("");
  
          var measured = measureOffsets(items.length);
          itemOffsets = measured.offsets;
          singleWidth = measured.total;
  
          buildDots(items.length);
          setArrowsVisible(true);
          startLoop();
        }
  
        // Solo al cargar la página por primera vez y con más de un producto
        // (el caso de un único producto ya se resolvió más arriba): abrimos
        // el panel con el primero del filtro activo.
        if(reason === "init" && items.length > 1){
          showDetailFromProduct(items[0]);
        }
      });
    });
  }
  
  function startLoop(){
    lastTs = null;
    rafId = requestAnimationFrame(tick);
  }
  
  function cancelAnimation(){
    if(rafId){ cancelAnimationFrame(rafId); rafId = null; }
  }
  
  function tick(ts){
    if(lastTs === null) lastTs = ts;
    var dt = (ts - lastTs) / 1000;
    lastTs = ts;
  
    if(!isPaused && !isDragging && !prefersReducedMotion && singleWidth > 0){
      position += SPEED * dt;
      if(position >= singleWidth) position -= singleWidth;
      if(position < 0) position += singleWidth;
    }
  
    trackEl.style.transform = "translateX(" + (-position) + "px)";
    updateActiveDot();
  
    rafId = requestAnimationFrame(tick);
  }
  
  /* ---------------- arrastre táctil (swipe en mobile) ---------------- */
  var wrap = document.querySelector(".rc-carousel");
  
  wrap.addEventListener("touchstart", function(e){
    var t = e.touches[0];
    isDragging = true;
    isPaused = true;
    dragStartX = t.clientX;
    dragStartPosition = position;
    touchStartY = t.clientY;
  }, {passive:true});
  
  wrap.addEventListener("touchmove", function(e){
    if(!isDragging || singleWidth <= 0) return;
    var t = e.touches[0];
    var dx = t.clientX - dragStartX;
    var dy = t.clientY - touchStartY;
  
    // Si el movimiento es más horizontal que vertical, es un swipe del
    // carrusel: evitamos que la página scrollee verticalmente mientras tanto.
    if(Math.abs(dx) > Math.abs(dy)){
      e.preventDefault();
    }
  
    var next = dragStartPosition - dx;
    next = ((next % singleWidth) + singleWidth) % singleWidth;
    position = next;
  }, {passive:false});
  
  wrap.addEventListener("touchend", function(){
    isDragging = false;
    isPaused = false;
  }, {passive:true});
  
  /* ---------------- resize: recalcular todo ---------------- */
  var resizeTimer;
var lastWidth = window.innerWidth;
window.addEventListener("resize", function(){
  var currentWidth = window.innerWidth;
  if(currentWidth === lastWidth) return; // solo cambió la altura: ignorar
  lastWidth = currentWidth;

  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(function(){ renderTrack("resize"); }, 200);
});
  
  /* ---------------- init ---------------- */
  renderTrack("init");
  
  });
  </script>