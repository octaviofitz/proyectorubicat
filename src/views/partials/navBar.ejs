<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Navegación</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>

  <nav class="sr-nav" aria-label="Primary" id="navBar">
    <div class="sr-nav__inner">
      <!-- El logo siempre se queda fijo en su posición -->
      <a href="/" class="sr-nav__brand" aria-label="Home">
        <img src="../../../images/iconos/logo.webp" class="imgNavbar" alt="Logo">
      </a>
  
      <!-- Desktop (más de 1024px) -->
      <div class="sr-nav__desktop">
        <ul class="sr-nav__list" role="list">
          <li><a class="sr-nav__link" href="/origen">Nosotros</a></li>
          <li><a class="sr-nav__link" href="/productos">Productos</a></li>
          <li><a class="sr-nav__link" href="/careers">Preguntas frecuentes</a></li>
<!--           <li><a class="sr-nav__link" href="/media-assets">Novedades</a></li>
 -->        </ul>
      </div>
  
      <!-- Botón hamburguesa que se anima a X (hasta 1024px) -->
      <button class="sr-nav__toggle" id="menuToggle" aria-expanded="false" aria-controls="sr-menu" aria-label="Abrir menú">
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
        <span class="icon-bar"></span>
      </button>
    </div>
  
    <!-- Desplegable inferior (solo la parte blanca con las opciones) -->
    <div id="sr-menu" class="sr-overlay" aria-hidden="true">
      <nav class="sr-overlay__nav" aria-label="Mobile">
        <a class="sr-overlay__link" href="/origen">Nosotros</a>
        <a class="sr-overlay__link" href="/productos">Productos</a>
        <a class="sr-overlay__link" href="/media-assets">Preguntas Frecuentes</a>
      </nav>
    </div>
  </nav>

  <script src="script.js"></script>
</body>
</html>